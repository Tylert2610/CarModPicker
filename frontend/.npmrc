# The @webbpulse scope resolves from the org CodeArtifact npm repository rather
# than the public registry. Everything else keeps the default registry.
#
# The auth token is deliberately not in this file. CI obtains one over OIDC in
# the reusable workflow, and locally you run:
#
#   AWS_PROFILE=WebbPulse-Artifacts/AdministratorAccess AWS_REGION=us-west-2 \
#     aws codeartifact login --tool npm --domain webbpulse \
#     --domain-owner 432410731887 --repository npm --namespace @webbpulse
#
# which appends the token to your ~/.npmrc. It expires after 12 hours.
#
# Never add a token to this file: it is tracked in git.
@webbpulse:registry=https://webbpulse-432410731887.d.codeartifact.us-west-2.amazonaws.com/npm/npm/
